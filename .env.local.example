NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser (no NEXT_PUBLIC_ prefix) or commit.
SUPABASE_SERVICE_ROLE_KEY=

# Push alerts (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional contact for push services; defaults to mailto:privacy@boathouseos.app
VAPID_SUBJECT=
